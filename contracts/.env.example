# OSO Web3 Songbook — contract deployment environment
# Copy to .env and fill in. NEVER commit the real .env.

# Deployer key — becomes the platform contractOwner (registers artists, nothing else).
# For local anvil you can use anvil's printed key #0.
DEPLOYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Sepolia RPC (any provider: Infura/Alchemy/public endpoint)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional: register the first artist in the same deploy run
FIRST_ARTIST_SLUG=shaka
FIRST_ARTIST_ADDR=0x0000000000000000000000000000000000000000

# Optional: Etherscan API key for --verify on Sepolia
ETHERSCAN_API_KEY=
